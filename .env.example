# Copy to .env and fill in real values locally — never commit .env itself.

TEST_ENV=prod
# Optional: overrides the environment's base_url from config/config.yaml
BASE_URL=

# A fixed, pre-registered account on the site, reused by every run for
# the authenticated tests (login is done once and the session cached).
# TEST_USER_NAME is the name the account was registered with — shown in
# the header as "Logged in as <name>".
TEST_EMAIL=
TEST_PASSWORD=
TEST_USER_NAME=
